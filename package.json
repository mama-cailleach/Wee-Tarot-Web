{
  "name": "wee-tarot-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run export:data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:font": "tsx scripts/build-tarotheque-font.ts",
    "export:data": "tsx scripts/export-content.ts",
    "export:data:ps": "powershell -ExecutionPolicy Bypass -File scripts/export-content.ps1",
    "test": "vitest run",
    "validate": "powershell -ExecutionPolicy Bypass -File scripts/validate-slice.ps1"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "fengari": "^0.1.4",
    "fengari-interop": "^0.1.3",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-static-copy": "^3.0.0",
    "vitest": "^3.1.4"
  }
}
